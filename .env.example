# Salin jadi .env lalu isi dari Supabase Dashboard > Project Settings > API.
# Tanpa dua nilai ini, Possir tetap jalan dalam mode demo (data di browser).
VITE_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
# Anon key (eyJ...) atau publishable key (sb_publishable_...). Aman dipakai di browser:
# semua akses dijaga Row Level Security dan fungsi RPC.
VITE_SUPABASE_ANON_KEY=
